{{ if lookPath "wslpath" -}}
#!/bin/sh
set -eu

# settings.json: {{ include "windows-terminal/settings.json" | sha256sum }}

src="$CHEZMOI_SOURCE_DIR/windows-terminal"
dest="$(wslpath "$(cmd.exe /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r')")/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState"

if [ ! -d "$dest" ]; then
  echo "windows-terminal: $dest not found, skipping"
  exit 0
fi

cp "$src/settings.json" "$dest/settings.json"
echo "windows-terminal: copied settings.json -> $dest/settings.json"
{{ end -}}
